# Create a Supabase project, run database/schema.sql in the SQL Editor,
# and enable Authentication > Providers > Anonymous Sign-Ins.
# The publishable/anon key is intended for browser usage. NEVER use a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
